# Copy to .env for LOCAL development only. .env is git-ignored.
# In production NOTHING here is set from a file — GEMINI_API_KEY comes from
# Secret Manager, injected by Cloud Run via --set-secrets.

# GCP / Firebase project id (same project for Firestore, Secret Manager, Auth)
GOOGLE_CLOUD_PROJECT=hisaab-local

# Local only: the Gemini key. In prod this env var is populated from
# Secret Manager secret "gemini-api-key". Never commit a real value.
GEMINI_API_KEY=

# Local only: point the Admin SDK + client at the emulators
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Frontend origin allowed by CORS (prod = the Cloud Run URL)
FRONTEND_ORIGIN=http://localhost:8000

# Model tiers
GEMINI_MODEL_CHAT=gemini-flash-latest
GEMINI_MODEL_UTILITY=gemini-flash-lite-latest

# Cost / rate guards
MAX_TURNS_PER_CASE=20
MAX_OUTPUT_TOKENS=1024
RATE_LIMIT_PER_5MIN=20
RATE_LIMIT_PER_DAY=60
MONTHLY_COST_CEILING_INR=40

# Evidence locker
EVIDENCE_MAX_BYTES=900000
EVIDENCE_MAX_ITEMS=40
# Optional: HMAC key that signs the exported appeal-record manifest. In prod
# this comes from Secret Manager secret "evidence-signing-key". If unset the
# manifest is still emitted (with hashes), just unsigned.
EVIDENCE_SIGNING_KEY=
