rules_version = '2';

// Hisaab: ALL data access is server-side via the Firebase Admin SDK, which
// bypasses these rules. No client ever holds a Firestore handle. So the
// rules deny every direct client request outright — defence in depth for
// "zero cross-user leakage": even a leaked client config cannot read a
// single document.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
